FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends git nodejs npm && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
RUN python -m pip install --upgrade pip && \
    python -m pip install "pydantic>=2.10" "fastapi>=0.115" \
      "uvicorn>=0.34" "python-multipart>=0.0.20"

COPY src ./src
RUN python -m pip install . --no-deps

RUN groupadd --system company && \
    useradd --system --gid company --home-dir /workspaces company && \
    mkdir -p /workspaces && chown -R company:company /app /workspaces

USER company
EXPOSE 8440
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
  CMD python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8440/health', timeout=2); raise SystemExit(0 if r.status == 200 else 1)"

CMD ["digital-company-execution-runtime"]
