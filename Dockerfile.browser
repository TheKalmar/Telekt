FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY pyproject.toml README.md ./
RUN python -m pip install --upgrade pip && \
    python -m pip install "openai-agents>=0.8.0" "pydantic>=2.10" "python-dotenv>=1.0" \
      "fastapi>=0.115" "uvicorn>=0.34" "python-multipart>=0.0.20" "playwright>=1.54" && \
    python -m playwright install --with-deps chromium

COPY src ./src
RUN python -m pip install . --no-deps

RUN groupadd --system browser && \
    useradd --system --gid browser --home-dir /app browser && \
    mkdir -p /browser-data && chown -R browser:browser /app /browser-data /ms-playwright

USER browser
EXPOSE 8430
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8430/health', timeout=3); raise SystemExit(0 if r.status == 200 else 1)"

CMD ["digital-company-browser"]
