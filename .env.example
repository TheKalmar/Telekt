# Required only when a company uses hybrid or cloud mode.
OPENAI_API_KEY=

# Cloud model used by AgentEngine. Override only after compatibility testing.
OPENAI_MODEL=gpt-5.4-mini
COMPUTER_USE_MODEL=gpt-5.6
COMPUTER_USE_MAX_STEPS=12

# Local FastAPI control-plane port.
PORT=8421
HOST=127.0.0.1

# Defaults work for a native installation. Docker Compose overrides these.
COMPANY_DATA_DIR=.company
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=deepseek-company:8b
MODEL_TIMEOUT_SECONDS=120
MODEL_TRANSIENT_RETRIES=2
STRUCTURED_OUTPUT_RETRIES=1
AGENT_MAX_TURNS=8
BILLING_USD_TO_BUDGET_RATE=1.0
CLOUD_CALL_RESERVE_EUR=0.05
# Stakeholder attention budget: routine approval email cadence.
STAKEHOLDER_CONTACT_INTERVAL_HOURS=24
BROWSER_RUNTIME_URL=http://127.0.0.1:8430

# Free self-hosted durable infrastructure (compose.infrastructure.yaml).
POSTGRES_USER=telekt
POSTGRES_PASSWORD=telekt-local-only
POSTGRES_DB=telekt
POSTGRES_PORT=5432
DATABASE_URL=postgresql://telekt:telekt-local-only@127.0.0.1:5432/telekt
DATABASE_BACKEND=sqlite
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# Set false to start bundled Ollama without downloading the default 5.2 GB model.
INSTALL_DEFAULT_MODEL=true

# Email approval delivery. Use a long random secret in every non-local setup.
APPROVAL_SIGNING_SECRET=
APPROVAL_LINK_TTL_HOURS=72
PUBLIC_BASE_URL=http://127.0.0.1:8421
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Shopify Dev Dashboard app credentials. Never paste these into the web UI.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
