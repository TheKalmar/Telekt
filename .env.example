# Required only when a company uses hybrid or cloud mode.
OPENAI_API_KEY=

# Cloud model used by AgentEngine. Override only after compatibility testing.
OPENAI_MODEL=gpt-5.4-mini

# Local FastAPI control-plane port.
PORT=8421
HOST=127.0.0.1

# Defaults work for a native installation. Docker Compose overrides these.
COMPANY_DATA_DIR=.company
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=deepseek-company:8b
MODEL_TIMEOUT_SECONDS=120
MODEL_TRANSIENT_RETRIES=2
STRUCTURED_OUTPUT_RETRIES=1
AGENT_MAX_TURNS=8

# Set false to start bundled Ollama without downloading the default 5.2 GB model.
INSTALL_DEFAULT_MODEL=true

# Email approval delivery. Use a long random secret in every non-local setup.
APPROVAL_SIGNING_SECRET=
APPROVAL_LINK_TTL_HOURS=72
PUBLIC_BASE_URL=http://127.0.0.1:8421
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
